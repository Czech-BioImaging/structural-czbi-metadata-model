digraph CZBIRD {
    rankdir=TB;
    graph [splines=true, nodesep=0.4, ranksep=0.7, bgcolor="transparent"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontcolor="white", color="#00000033", penwidth=1.2];
    edge  [fontname="Helvetica", fontsize=10, color="#555555"];

    "CZBIRDAnalysedDataProfile" [label="AnalysedDataProfile", fillcolor="#7c3aed", shape=hexagon];
    "CZBIRDAnalysedPipeline" [label="AnalysedPipeline", fillcolor="#2563eb", shape=box];
    "CZBIRDDigitalImageSink" [label="DigitalImageSink", fillcolor="#059669", shape=ellipse];
    "CZBIRDDigitalObjectSink" [label="DigitalObjectSink", fillcolor="#059669", shape=ellipse];
    "CZBIRDGeneralRecordProfile" [label="GeneralRecordProfile", fillcolor="#7c3aed", shape=hexagon];
    "CZBIRDImageAcquisitionStep" [label="ImageAcquisitionStep", fillcolor="#0891b2", shape=box];
    "CZBIRDImageAnalysisStep" [label="ImageAnalysisStep", fillcolor="#0891b2", shape=box];
    "CZBIRDImageProcessingStep" [label="ImageProcessingStep", fillcolor="#0891b2", shape=box];
    "CZBIRDMethod" [label="Method", fillcolor="#d97706", shape=box];
    "CZBIRDOntologyTerm" [label="OntologyTerm", fillcolor="#059669", shape=ellipse];
    "CZBIRDOrganism" [label="Organism", fillcolor="#d97706", shape=box];
    "CZBIRDProcessedDataProfile" [label="ProcessedDataProfile", fillcolor="#7c3aed", shape=hexagon];
    "CZBIRDProcessedPipeline" [label="ProcessedPipeline", fillcolor="#2563eb", shape=box];
    "CZBIRDRawDataProfile" [label="RawDataProfile", fillcolor="#7c3aed", shape=hexagon];
    "CZBIRDRawPipeline" [label="RawPipeline", fillcolor="#2563eb", shape=box];
    "CZBIRDSamplePreparationStep" [label="SamplePreparationStep", fillcolor="#0891b2", shape=box];
    "CZBIRDSpecimen" [label="Specimen", fillcolor="#d97706", shape=box];
    "CZBIRDTaxon" [label="Taxon", fillcolor="#d97706", shape=box];
    "CZBIRDTool" [label="Tool", fillcolor="#059669", shape=ellipse];
    "Metadata" [label="Metadata", fillcolor="#1f2937", shape=box];

    "Metadata" -> "CZBIRDAnalysedDataProfile" [style=dashed, label="profile_type"];
    "Metadata" -> "CZBIRDGeneralRecordProfile" [style=dashed, label="profile_type"];
    "Metadata" -> "CZBIRDProcessedDataProfile" [style=dashed, label="profile_type"];
    "Metadata" -> "CZBIRDRawDataProfile" [style=dashed, label="profile_type"];
    "CZBIRDTaxon" -> "CZBIRDOntologyTerm" [label="accepted_scientific_name", penwidth=1.0];
    "CZBIRDTaxon" -> "CZBIRDOntologyTerm" [label="taxon_rank", penwidth=1.0];
    "CZBIRDOrganism" -> "CZBIRDTaxon" [label="belongs_to", penwidth=1.0];
    "CZBIRDSpecimen" -> "CZBIRDOrganism" [label="is_part_of_organism", penwidth=1.0];
    "CZBIRDSpecimen" -> "CZBIRDOntologyTerm" [label="is_part_of[]", penwidth=2.2];
    "CZBIRDMethod" -> "CZBIRDOntologyTerm" [label="method_type_label[]", penwidth=2.2];
    "CZBIRDSamplePreparationStep" -> "CZBIRDMethod" [label="realizes_method", penwidth=1.0];
    "CZBIRDSamplePreparationStep" -> "CZBIRDTool" [label="employs_tool", penwidth=1.0];
    "CZBIRDSamplePreparationStep" -> "CZBIRDDigitalObjectSink" [label="digital_object_sink[]", penwidth=2.2];
    "CZBIRDImageAcquisitionStep" -> "CZBIRDMethod" [label="realizes_method", penwidth=1.0];
    "CZBIRDImageAcquisitionStep" -> "CZBIRDTool" [label="employs_tool", penwidth=1.0];
    "CZBIRDImageAcquisitionStep" -> "CZBIRDDigitalImageSink" [label="digital_image_sink", penwidth=1.0];
    "CZBIRDImageProcessingStep" -> "CZBIRDMethod" [label="realizes_method", penwidth=1.0];
    "CZBIRDImageProcessingStep" -> "CZBIRDTool" [label="employs_tool", penwidth=1.0];
    "CZBIRDImageProcessingStep" -> "CZBIRDDigitalObjectSink" [label="digital_object_sink[]", penwidth=2.2];
    "CZBIRDImageProcessingStep" -> "CZBIRDDigitalImageSink" [label="digital_image_sink[]", penwidth=2.2];
    "CZBIRDImageAnalysisStep" -> "CZBIRDMethod" [label="realizes_method", penwidth=1.0];
    "CZBIRDImageAnalysisStep" -> "CZBIRDTool" [label="employs_tool", penwidth=1.0];
    "CZBIRDImageAnalysisStep" -> "CZBIRDDigitalObjectSink" [label="digital_object_sink[]", penwidth=2.2];
    "CZBIRDImageAnalysisStep" -> "CZBIRDDigitalImageSink" [label="digital_image_sink[]", penwidth=2.2];
    "CZBIRDRawPipeline" -> "CZBIRDSpecimen" [label="specimen", penwidth=1.0];
    "CZBIRDRawPipeline" -> "CZBIRDSamplePreparationStep" [label="sample_preparation_step[]", penwidth=2.2];
    "CZBIRDRawPipeline" -> "CZBIRDImageAcquisitionStep" [label="image_acquisition_step[]", penwidth=2.2];
    "CZBIRDProcessedPipeline" -> "CZBIRDImageProcessingStep" [label="image_processing_step[]", penwidth=2.2];
    "CZBIRDProcessedPipeline" -> "CZBIRDDigitalImageSink" [label="result_data[]", penwidth=2.2];
    "CZBIRDAnalysedPipeline" -> "CZBIRDImageProcessingStep" [label="image_processing_step[]", penwidth=2.2];
    "CZBIRDAnalysedPipeline" -> "CZBIRDImageAnalysisStep" [label="image_analysis_step[]", penwidth=2.2];
    "CZBIRDAnalysedPipeline" -> "CZBIRDDigitalObjectSink" [label="result_data_objects[]", penwidth=2.2];
    "CZBIRDAnalysedPipeline" -> "CZBIRDDigitalImageSink" [label="result_data_images[]", penwidth=2.2];
    "CZBIRDRawDataProfile" -> "CZBIRDRawPipeline" [label="raw_data[]", penwidth=2.2];
    "CZBIRDProcessedDataProfile" -> "CZBIRDProcessedPipeline" [label="processed_data[]", penwidth=2.2];
    "CZBIRDAnalysedDataProfile" -> "CZBIRDAnalysedPipeline" [label="analysed_data[]", penwidth=2.2];
}
